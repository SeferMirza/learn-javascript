{
  "name": "@mouseless/nuxt-module",
  "version": "0.0.1",
  "description": "Learn project for how to create and publish a Nuxt module",
  "homepage": "https://mouseless.codes",
  "repository": {
    "type": "git",
    "url": "https://github.com/mouseless/learn-javascript.git"
  },
  "author": "mouseless",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "nuxi prepare",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nuxt/kit": "4.0.1",
    "@primeuix/themes": "1.2.1",
    "@nuxtjs/tailwindcss": "6.14.0",
    "primeicons": "7.0.0",
    "primevue": "4.3.6"
  },
  "devDependencies": {
    "@nuxt/devtools": "2.6.2",
    "@nuxt/eslint-config": "1.7.0",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "4.0.1",
    "@nuxt/test-utils": "3.19.2",
    "@types/node": "24.0.15",
    "changelogen": "0.6.2",
    "eslint": "9.31.0",
    "nuxt": "3.17.7",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.3"
  },
  "bundleDependencies": ["@primevue/themes", "primeicons", "primevue"]
}
